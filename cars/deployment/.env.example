# cars/deployment/docker-compose.yml — environment template.
# Copy to `.env` (same dir) and fill in. NEVER commit the real `.env` — it is gitignored
# and the gitleaks pre-commit hook will block accidental secret commits.
#
#   cp cars/deployment/.env.example cars/deployment/.env
#   # edit values, then:  docker compose -f cars/deployment/docker-compose.yml up -d

# PostgreSQL password for the bundled `postgres:16` service (choose a strong value).
POSTGRES_PASSWORD=change-me-strong-password

# Public host Label Studio is served at, e.g. labelstudio.example.com (no scheme).
LABEL_STUDIO_HOST=labelstudio.example.com

# CSRF trusted origins (full URL with scheme), comma-separated.
CSRF_TRUSTED_ORIGINS=https://labelstudio.example.com

# Optional bootstrap admin created on first run (leave blank to create via UI).
LABEL_STUDIO_USERNAME=
LABEL_STUDIO_PASSWORD=

# Cloudflare Tunnel connector token (only if you expose via Cloudflare Tunnel;
# otherwise drop the `cloudflared` service from the compose file and publish the
# `label-studio` nginx port behind your own reverse proxy / TLS).
CF_TUNNEL_TOKEN=
